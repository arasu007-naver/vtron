# Supabase — server-side only (service role key bypasses RLS).
# Same project as the vtron web app: see ../../.env.local
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BUCKET=product-images
SUPABASE_TABLE=products

# Browser capture — Chrome over CDP, started by ./start_chrome_debug.mac.sh
CDP_URL=http://127.0.0.1:9222
WAIT_MS=1500
TIMEOUT_MS=45000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900

# Static Authorization: Bearer token (curl / scripts). Supabase user access tokens are accepted too.
API_KEY=
MAX_ITEMS_PER_REQUEST=50
STOP_ON_BLOCK=true
