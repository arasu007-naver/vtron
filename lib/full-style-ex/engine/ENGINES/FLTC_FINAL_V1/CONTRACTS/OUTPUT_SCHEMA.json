{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "STMX Full-Look TC Direction record",
 "type": "object",
 "required": [
  "axis",
  "resolver",
  "authority",
  "status",
  "direction"
 ],
 "properties": {
  "axis": {
   "const": "TC"
  },
  "resolver": {
   "const": "STMX_FULL_LOOK_TC_PRODUCT_ONLY_RESOLVER_V3_FINAL_CANDIDATE"
  },
  "authority": {
   "const": "STMX_FULL_LOOK_TC_DIRECTION_CONSTITUTION_FINAL_V1"
  },
  "status": {
   "enum": [
    "RESOLVED",
    "TECHNICAL_EXCEPTION"
   ]
  },
  "direction": {
   "enum": [
    "CLASSIC",
    "TRANSFORMATIVE",
    null
   ]
  },
  "rule": {
   "enum": [
    "TC-P1",
    "TC-C",
    null
   ]
  },
  "resolved_by": {
   "enum": [
    "DIRECT",
    "AVAILABLE_EVIDENCE",
    null
   ]
  },
  "basis": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "classic_support",
    "departures",
    "missing_observations",
    "unknown_identity",
    "interpretive_gaps",
    "frame_limits",
    "sensitivity",
    "sensitive_to",
    "possible_outcomes_if_observed"
   ],
   "properties": {
    "sensitivity": {
     "enum": [
      "NONE",
      "POSSIBLE"
     ]
    },
    "possible_outcomes_if_observed": {
     "type": "array",
     "items": {
      "enum": [
       "CLASSIC",
       "TRANSFORMATIVE"
      ]
     }
    }
   }
  },
  "exception": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "code",
    "class"
   ],
   "properties": {
    "code": {
     "enum": [
      "INPUT_CONTRACT",
      "NO_OBSERVABLE_WORN_LOOK",
      "NO_GARMENT_OBSERVED",
      "NO_TC_PRODUCT_EVIDENCE"
     ]
    },
    "class": {
     "const": "INPUT_FAILURE"
    }
   }
  },
  "rule_trace": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "const": "RESOLVED"
     }
    }
   },
   "then": {
    "required": [
     "rule",
     "basis",
     "resolved_by"
    ],
    "properties": {
     "direction": {
      "enum": [
       "CLASSIC",
       "TRANSFORMATIVE"
      ]
     },
     "exception": {
      "const": null
     }
    }
   },
   "else": {
    "required": [
     "exception"
    ],
    "properties": {
     "direction": {
      "const": null
     }
    }
   }
  }
 ]
}